# Server configuration
PORT=3001
NODE_ENV=development

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Auth and JWT Secrets
JWT_SECRET=supersecret_jwt_key_ticket_system_2024
REFRESH_TOKEN_SECRET=supersecret_refresh_jwt_key_ticket_system_2024
COOKIE_SECRET=supersecret_cookie_signing_key_2024

# Token expirations (in seconds)
# 15 minutes = 900 seconds
SESSION_EXPIRY=60 * 15
# 30 days = 2592000 seconds
REFRESH_TOKEN_EXPIRY=60 * 60 * 24 * 30

# CORS Whitelist (comma-separated origins)
WHITELISTED_DOMAINS=http://localhost:3000,http://localhost:3001
